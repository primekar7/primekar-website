# PrimeKar Website — environment variable template
#
# Copy this file to .env.local and fill in real values there. .env.local is
# gitignored and must never be committed. Never put real secrets in this file
# (.env.example) — placeholders only.
#
# Nothing below is required yet: as of environment setup, this project has no
# database, analytics, or form/email service configured (intentionally, per
# setup scope — see docs/setup-report.md). This file will grow as those are
# added.

# Public site URL, used for metadata/canonical links once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Not env vars in this file ---
# The Context7 MCP server's API key is a Claude Code tool credential, not a
# Next.js runtime secret. It lives in .claude/settings.local.json (gitignored,
# never committed) and is referenced in .mcp.json via ${CONTEXT7_API_KEY}
# expansion. See docs/setup-report.md for details.
