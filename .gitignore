# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings (may contain API keys / secrets, never commit)
.claude/settings.local.json

# python bytecode cache (generated, not source)
__pycache__/
*.pyc

# internal Phase A source material (blueprint PDF, build-prompt source,
# audit-only logo masters, audit-only screenshots) — not for public serving
# see docs/asset-audit.md and docs/decision-log.md (OPEN-12)
docs/source-material/

# visual-reset concept prototypes (research phase — never commit)
/prototypes/
